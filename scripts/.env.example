# Therefore ADFS/SSO Testing Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git - it contains secrets!

# =============================================================================
# Azure AD / Entra Configuration
# =============================================================================

# Your Azure AD Tenant ID (from Azure Portal → Azure AD → Overview)
ENTRA_TENANT_ID=your-tenant-id-here

# Your App Registration's Client ID (Application ID)
ENTRA_CLIENT_ID=your-app-client-id-here

# Your App Registration's Client Secret (from Certificates & secrets)
ENTRA_CLIENT_SECRET=your-client-secret-here

# Your username and password for ROPC flow (not recommended for MFA accounts)
ENTRA_USERNAME=your.email@company.com
ENTRA_PASSWORD=your-password-here

# Scopes to request (usually don't need to change)
# ENTRA_SCOPES=openid profile User.Read

# =============================================================================
# Therefore Configuration
# =============================================================================

# Your Therefore Online URL
THEREFORE_BASE_URL=https://yourcompany.thereforeonline.com/theservice/v0001/restun

# Connect mode for token exchange: NoLicenseMove, ConnectForSignOut, or MoveLicense
# NoLicenseMove = don't consume a license (good for testing)
# MoveLicense = consume a license (full functionality)
CONNECT_MODE=NoLicenseMove

# =============================================================================
# Token File Locations (optional - defaults shown)
# =============================================================================

# ENTRA_TOKEN_FILE=.entra_token.txt
# THEREFORE_TOKEN_FILE=.therefore_token.txt
